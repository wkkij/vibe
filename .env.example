# Chrome DevTools Protocol URL (Chrome started with --remote-debugging-port, see scripts/)
VIBE_CHROME_CDP_URL=http://127.0.0.1:9222

# Auto-verification command after patching (e.g. "npm run build", "pytest", "tsc --noEmit")
VIBE_VERIFY_CMD=

# Max auto-healing retries on build/test failure
VIBE_MAX_HEAL_RETRIES=4

# Upload repository context as a file attachment
VIBE_UPLOAD_CONTEXT_AS_FILE=true

# Model name/number substring for Gemini picker (e.g. "pro", "thinking"); empty = Gemini default. Or use /model
VIBE_MODEL=

# How project files reach the chat: auto | file | paste | inline | base64
VIBE_TRANSPORT=auto

# AI provider: gemini | claude | aistudio (or /provider)
VIBE_PROVIDER=gemini

# Separate Chrome (own profile and port) for claude.ai: scripts/start_chrome_claude_*
VIBE_CLAUDE_CDP_URL=http://127.0.0.1:9223
VIBE_CLAUDE_MODEL=

# Reasoning level for Gemini: low | medium | high | off (or /reasoning)
VIBE_REASONING=

# Google AI Studio (aistudio.google.com): тот же аккаунт и Chrome, что у Gemini. Модель — ID, например gemini-2.5-pro
VIBE_AISTUDIO_CDP_URL=http://127.0.0.1:9222
VIBE_AISTUDIO_MODEL=

# Автоподбор контекста по описанию задачи и стиль промпта (auto|classic|concise|strict|mentor|pair|friendly)
VIBE_AUTO_CONTEXT=false
VIBE_PROMPT_STYLE=auto
